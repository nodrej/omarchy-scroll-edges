{
  "schemaVersion": 1,
  "id": "io.github.nodrej.scroll-edges",
  "name": "Scroll edges",
  "version": "1.3.0",
  "author": "nodrej",
  "license": "MIT",
  "repository": "https://github.com/nodrej/omarchy-scroll-edges",
  "description": "Highlights a screen edge when the scrolling layout has windows parked past it, with a count of how many.",
  "kinds": [
    "service",
    "panel",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "ScrollEdges.qml",
    "panel": "SettingsPanel.qml",
    "barWidget": "BarIcon.qml"
  },
  "barWidget": {
    "displayName": "Scroll edges",
    "description": "Opens the Scroll edges settings.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right"
  }
}
